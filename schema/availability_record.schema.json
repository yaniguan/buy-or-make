{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "default": "software",
          "enum": [
            "human",
            "robot",
            "model",
            "software",
            "instrument"
          ],
          "title": "Type",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "Molecule": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "inchikey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inchikey"
        },
        "kind": {
          "const": "molecule",
          "default": "molecule",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "smiles": {
          "title": "Smiles",
          "type": "string"
        }
      },
      "required": [
        "smiles"
      ],
      "title": "Molecule",
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Id"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "fetched_utc": {
          "title": "Fetched Utc",
          "type": "string"
        },
        "in_stock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Stock"
        },
        "inchikey": {
          "title": "Inchikey",
          "type": "string"
        },
        "lead_time_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Time Days"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "pack_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "price_basis": {
          "default": "unknown",
          "enum": [
            "listed_catalog",
            "unknown"
          ],
          "title": "Price Basis",
          "type": "string"
        },
        "purity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purity"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "inchikey",
        "vendor",
        "source_id",
        "source_url",
        "license"
      ],
      "title": "Offer",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRef"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "recorded_utc": {
          "title": "Recorded Utc",
          "type": "string"
        },
        "software": {
          "items": {
            "$ref": "#/$defs/SoftwareRef"
          },
          "title": "Software",
          "type": "array"
        },
        "source_file_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File Sha256"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "used": {
          "items": {
            "type": "string"
          },
          "title": "Used",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "raw_unit_str": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Unit Str"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
