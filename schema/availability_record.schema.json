        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "SoftwareRef",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "kind": {
          "default": "none",
          "enum": [
            "std",
            "interval",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "std": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_source": {
      "default": "unknown",
      "enum": [
        "live_vendor_registry",
        "local_vendor_catalog",
        "open_stopping_stock",
        "synthetic_reference_catalog",
        "unmatched",
        "unknown"
      ],
      "title": "Data Source",
      "type": "string"
    },
    "inchikey_match": {
      "default": "none",
      "enum": [
        "exact",
        "salt_equivalent",
        "stereoisomer_relaxed",
        "none"
      ],
      "title": "Inchikey Match",
      "type": "string"
    },
    "lead_time_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lead Time Days"
    },
    "leaf_offers": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Offer"
        },
        "type": "array"
      },
      "title": "Leaf Offers",
      "type": "object"
    },
    "licenses": {
      "items": {
        "type": "string"
      },
      "title": "Licenses",
      "type": "array"
    },
    "matched_offer_inchikeys": {
      "items": {
        "type": "string"
      },
      "title": "Matched Offer Inchikeys",
      "type": "array"
    },
    "molecule": {
      "$ref": "#/$defs/Molecule"
    },
    "moq_pack_g": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Moq Pack G"
    },
    "offers": {
      "items": {
        "$ref": "#/$defs/Offer"
      },
      "title": "Offers",
      "type": "array"
    },
    "origin": {
      "default": "real",
      "enum": [
        "real",
        "simulated",
        "model_generated",
        "synthetic_demo"
      ],
      "title": "Origin",
      "type": "string"
    },
    "precursor_smiles": {
      "items": {
        "type": "string"
      },
      "title": "Precursor Smiles",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Hash"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/Route"
      },
      "title": "Routes",
      "type": "array"
    },
    "sa_scores": {
      "$ref": "#/$defs/SAScores"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stereoisomer_offers": {
      "items": {
        "$ref": "#/$defs/Offer"
      },
      "title": "Stereoisomer Offers",
      "type": "array"
    }
  },
  "required": [
    "molecule"
  ],
  "title": "AvailabilityRecord",
  "type": "object"
}
