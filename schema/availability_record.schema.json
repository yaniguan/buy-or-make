        "reaction_smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Smiles"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "template_or_reference": {
          "title": "Template Or Reference",
          "type": "string"
        }
      },
      "required": [
        "product",
        "reactants",
        "template_or_reference",
        "source"
      ],
      "title": "RouteStep",
      "type": "object"
    },
    "SAScores": {
      "additionalProperties": false,
      "properties": {
        "rascore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rascore"
        },
        "sascore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sascore"
        },
        "scscore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scscore"
        }
      },
      "title": "SAScores",
      "type": "object"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
