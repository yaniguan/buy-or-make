        "unit": {
          "default": "1",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Quantity",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "est_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated stoichiometric leaf-only cost per 1 g of target in '<currency>/g' (e.g. 'USD/g'), independent of target_scale_g."
        },
        "est_cost_complete": {
          "title": "Est Cost Complete",
          "type": "boolean"
        },
        "est_cost_method": {
          "title": "Est Cost Method",
          "type": "string"
        },
        "est_cost_yield_adjusted": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Step-depth yield-compounded leaf-only cost per 1 g of target in '<currency>/g' (e.g. 'USD/g')."
        },
        "leaves": {
          "items": {
            "type": "string"
          },
          "title": "Leaves",
          "type": "array"
        },
        "leaves_purchasable": {
          "items": {
            "type": "boolean"
          },
          "title": "Leaves Purchasable",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "min_outlay_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum discrete pack MOQ cash outlay for the full target_scale_g order in absolute '<currency>' (e.g. 'USD')."
        },
        "n_steps": {
          "title": "N Steps",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "step_yield_assumed": {
          "default": 1.0,
          "title": "Step Yield Assumed",
          "type": "number"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/RouteStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "target_inchikey": {
          "title": "Target Inchikey",
          "type": "string"
        },
        "tree_depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tree Depth"
        }
      },
      "required": [
        "target_inchikey",
        "n_steps",
        "steps",
        "leaves",
        "leaves_purchasable",
        "method",
        "est_cost_method",
        "est_cost_complete"
      ],
      "title": "Route",
      "type": "object"
    },
    "RouteStep": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "title": "Product",
          "type": "string"
